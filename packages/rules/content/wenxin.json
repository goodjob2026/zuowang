[
 {
  "id": "wx_01",
  "text": "山道上，黑衫汉子一脚踹翻了卖柴老汉的担子，围观众人个个低头看着脚尖。你立在人群里，打算怎么办？",
  "options": [
   {
    "label": "站出人群大喝一声，死不退让",
    "shan": 2,
    "gang": 2,
    "dong": 2,
    "qing": 1
   },
   {
    "label": "乱中扶起老汉，不留姓名",
    "shan": 2,
    "gang": -2,
    "dong": 0,
    "qing": 1
   },
   {
    "label": "低头走过，各人自有各人的命",
    "shan": -1,
    "gang": -1,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "乘乱拾起地上的钱袋",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_02",
  "text": "血战方歇，你与同伴手里只剩一枚宝丹。两人都盯着它，谁也没先开口。你心头最先转的是什么念头？",
  "options": [
   {
    "label": "你伤得重，你来吃",
    "shan": 2,
    "gang": -1,
    "dong": -1,
    "qing": 2
   },
   {
    "label": "掏出骰子，一把定输赢",
    "shan": 1,
    "gang": 1,
    "dong": -1,
    "qing": -1
   },
   {
    "label": "我先吃了，下回各凭本事",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "谎称丹有毒，转头自己吞了",
    "shan": -2,
    "gang": -1,
    "dong": 0,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_03",
  "text": "夜深入定，灯芯忽地爆响一声。你问起自己：这些年苦修，到底图个什么？",
  "options": [
   {
    "label": "只图身边这些人平安",
    "shan": 2,
    "gang": -1,
    "dong": 0,
    "qing": 2
   },
   {
    "label": "想参透天道，跳出生死",
    "shan": 0,
    "gang": 1,
    "dong": 1,
    "qing": -2
   },
   {
    "label": "想教四方都念我的名号",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "只求自己活得久、活得闲",
    "shan": -2,
    "gang": -2,
    "dong": -2,
    "qing": 1
   }
  ]
 },
 {
  "id": "wx_04",
  "text": "你独坐崖边，山风灌满两袖。案上酒、琴、剑、书各陈一样，你先伸手取哪一样？",
  "options": [
   {
    "label": "提壶邀月，长啸一声",
    "shan": 0,
    "gang": 2,
    "dong": 1,
    "qing": 2
   },
   {
    "label": "轻拨琴弦，等老友来",
    "shan": 1,
    "gang": -2,
    "dong": -2,
    "qing": 2
   },
   {
    "label": "取磨石磨剑，等天亮出手",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "翻开旧册，续推功法",
    "shan": 0,
    "gang": -1,
    "dong": -1,
    "qing": -2
   }
  ]
 },
 {
  "id": "wx_05",
  "text": "当年追杀你三百里的仇人，此刻跪在泥里，双手捧着全部家当求饶。你的剑垂在身侧，这笔账怎么了结？",
  "options": [
   {
    "label": "让开道路，放他走",
    "shan": 2,
    "gang": -2,
    "dong": -1,
    "qing": 2
   },
   {
    "label": "废他经脉，只留一口气",
    "shan": 0,
    "gang": 1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "收下包袱，再补一剑",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "一言不发，一剑了结",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_06",
  "text": "师父打开一只箱子，说只许挑一件带在身边，往后几十年不得更换。你伸手取的是哪一件？",
  "options": [
   {
    "label": "取那只旧药葫芦",
    "shan": 2,
    "gang": -1,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "取那柄没有名字的铁剑",
    "shan": 0,
    "gang": 2,
    "dong": 1,
    "qing": 0
   },
   {
    "label": "取那面照不清人的古铜镜",
    "shan": -1,
    "gang": -2,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "取那块沾血的令牌",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": 2
   }
  ]
 },
 {
  "id": "wx_07",
  "text": "山脚村里家家供着一尊神像，香火极盛。你一眼看出神像里养的是邪物，村人却正围着它磕头。你打算如何处置？",
  "options": [
   {
    "label": "抬手砸碎，谁拦也不理",
    "shan": 1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "挨家挨户劝，让他们自己拆",
    "shan": 2,
    "gang": -2,
    "dong": 0,
    "qing": 1
   },
   {
    "label": "夜里潜入，抽走其中灵气",
    "shan": -2,
    "gang": -1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "只作没看见，改道而行",
    "shan": -1,
    "gang": -2,
    "dong": -2,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_08",
  "text": "长老召你到殿后，低声吩咐了一件你不愿做的事，案上还压着一袋灵石。你抬眼望他，如何作答？",
  "options": [
   {
    "label": "弟子不做，任凭您罚",
    "shan": 2,
    "gang": 2,
    "dong": 1,
    "qing": 1
   },
   {
    "label": "先应下，转头把那人放走",
    "shan": 1,
    "gang": -2,
    "dong": -1,
    "qing": 2
   },
   {
    "label": "照办，赏钱先收下",
    "shan": -1,
    "gang": -1,
    "dong": -1,
    "qing": -2
   },
   {
    "label": "满口应承，再多讨些赏",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_09",
  "text": "林中白鹿拦住去路，口吐人言，求你别伤它。它眼里湿漉漉的，你对它说什么？",
  "options": [
   {
    "label": "去吧，不必谢我",
    "shan": 2,
    "gang": -1,
    "dong": -1,
    "qing": 2
   },
   {
    "label": "随我同行吧，路上有个伴",
    "shan": 1,
    "gang": -2,
    "dong": 1,
    "qing": 2
   },
   {
    "label": "留下鹿角，我拿去入药",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "你拿什么来交换",
    "shan": -1,
    "gang": 2,
    "dong": 0,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_10",
  "text": "你闭关十年方才出山，台阶上坐着当年同分一个馒头的兄弟，如今满身黑气，正冲你笑。你当如何？",
  "options": [
   {
    "label": "拔剑，就在这台阶上了结",
    "shan": 0,
    "gang": 2,
    "dong": 1,
    "qing": 1
   },
   {
    "label": "坐到他身旁，再劝一回",
    "shan": 2,
    "gang": -1,
    "dong": 1,
    "qing": 1
   },
   {
    "label": "转身绕道，不愿再见",
    "shan": -1,
    "gang": -2,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "笑着应承，各取所需",
    "shan": -2,
    "gang": 1,
    "dong": -1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_11",
  "text": "有人在路边递来一部失传功法，开价是立誓替他杀一个人。纸页尚带体温。你怎么答他？",
  "options": [
   {
    "label": "不要，你拿回去吧",
    "shan": 2,
    "gang": 2,
    "dong": 0,
    "qing": 1
   },
   {
    "label": "先应下，学到手再作计较",
    "shan": -2,
    "gang": -1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "应下，只须那人该杀",
    "shan": 0,
    "gang": 1,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "反手一剑杀了他，两不相欠",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_12",
  "text": "雨夜破庙里，角落躺着一个浑身是血的陌生人，身旁包袱鼓鼓囊囊。你抖去蓑衣上的雨水，打算怎么办？",
  "options": [
   {
    "label": "撕下衣襟裹伤，守他到天亮",
    "shan": 2,
    "gang": -2,
    "dong": 1,
    "qing": 2
   },
   {
    "label": "把干粮放在他手边，转身走了",
    "shan": 1,
    "gang": 1,
    "dong": -2,
    "qing": 0
   },
   {
    "label": "瞧一眼，只当没来过",
    "shan": -1,
    "gang": -1,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "蹲下身，翻开他的包袱",
    "shan": -2,
    "gang": 2,
    "dong": 2,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_13",
  "text": "斗法已分高下，对手瘫倒在地，嘴里仍骂骂咧咧。你的剑尖离他喉头三寸，接下来怎么做？",
  "options": [
   {
    "label": "收剑入鞘，任他去骂",
    "shan": 2,
    "gang": -1,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "挑断他一条臂膀",
    "shan": -1,
    "gang": 2,
    "dong": 2,
    "qing": -1
   },
   {
    "label": "他骂一句，我回十句",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": 2
   },
   {
    "label": "转身便走，懒得理会",
    "shan": 0,
    "gang": -2,
    "dong": -2,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_14",
  "text": "听闻山腹洞府里藏着一份机缘，只够一人得，已有几拨人摸了进去。你立在洞口，心里如何盘算？",
  "options": [
   {
    "label": "进去瞧瞧，抢不到便罢",
    "shan": 1,
    "gang": -2,
    "dong": -1,
    "qing": -2
   },
   {
    "label": "寻人搭伙，事后平分",
    "shan": 1,
    "gang": 1,
    "dong": -1,
    "qing": -1
   },
   {
    "label": "尾随其后，等他们拼完",
    "shan": -2,
    "gang": -1,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "抢在头里，先下手为强",
    "shan": -1,
    "gang": 2,
    "dong": 2,
    "qing": 1
   }
  ]
 },
 {
  "id": "wx_15",
  "text": "山门之前，考官只问一句：你为何修仙？身后长队排着，哪一句最像你的真话？",
  "options": [
   {
    "label": "想护住我想护的人",
    "shan": 2,
    "gang": 1,
    "dong": -1,
    "qing": 2
   },
   {
    "label": "想亲眼看看天有多大",
    "shan": 1,
    "gang": -2,
    "dong": 2,
    "qing": 1
   },
   {
    "label": "不愿再被人踩在脚下",
    "shan": -1,
    "gang": 2,
    "dong": 0,
    "qing": 2
   },
   {
    "label": "想比所有人活得都久",
    "shan": -2,
    "gang": -1,
    "dong": -2,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_16",
  "text": "同门借去你的法宝，归还时已裂作两半，他红着脸说愿意赔。你看着那两截，怎么回话？",
  "options": [
   {
    "label": "不必赔，缘分尽了",
    "shan": 2,
    "gang": -2,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "下回当心些便是",
    "shan": 1,
    "gang": 1,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "照市价赔，一文不少",
    "shan": -1,
    "gang": 2,
    "dong": 1,
    "qing": -1
   },
   {
    "label": "既要赔，就翻几倍来",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_17",
  "text": "坊市人群里，你脚下忽被绊了一下，是只储物袋，内有灵石，另有一封未封口的家书。四下无人来认，你怎么处置？",
  "options": [
   {
    "label": "四下打听，原物奉还",
    "shan": 2,
    "gang": 1,
    "dong": 1,
    "qing": 1
   },
   {
    "label": "信送回去，灵石自己留下",
    "shan": -1,
    "gang": -1,
    "dong": 0,
    "qing": -1
   },
   {
    "label": "揣入怀中，当没捡过",
    "shan": -2,
    "gang": -2,
    "dong": -1,
    "qing": -1
   },
   {
    "label": "交予执事，自己不沾手",
    "shan": 1,
    "gang": -1,
    "dong": -2,
    "qing": -2
   }
  ]
 },
 {
  "id": "wx_18",
  "text": "天边裂开一道光，宝物坠入山谷，众修士推搡着往下抢。你立于崖边，是冲在最前，还是退到最后？",
  "options": [
   {
    "label": "冲下崖去，各凭本事",
    "shan": 0,
    "gang": 2,
    "dong": 2,
    "qing": 0
   },
   {
    "label": "退到后头，捡别人剩下的",
    "shan": -1,
    "gang": -2,
    "dong": -2,
    "qing": -2
   },
   {
    "label": "递一句话，让旁人替我去争",
    "shan": -2,
    "gang": -1,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "守住外围，接应弱者撤离",
    "shan": 2,
    "gang": 1,
    "dong": 1,
    "qing": 1
   }
  ]
 },
 {
  "id": "wx_19",
  "text": "半夜里你途经后山，撞见师兄正与魔修低声交谈。他脸色发白，递来一只鼓鼓的锦囊。你怎么办？",
  "options": [
   {
    "label": "转身报与宗门，不留情面",
    "shan": 1,
    "gang": 2,
    "dong": 1,
    "qing": -2
   },
   {
    "label": "给他限期，叫他回头",
    "shan": 2,
    "gang": -2,
    "dong": 0,
    "qing": 1
   },
   {
    "label": "装作没看见，自身要紧",
    "shan": -1,
    "gang": -1,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "收下锦囊，往后月月来取",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_20",
  "text": "岔路口立着两块路牌：一条平坦，却要多走三天；一条悬在崖边，却能早到。同伴在后头催你，你选哪条？",
  "options": [
   {
    "label": "走崖边那条，早到早了",
    "shan": 0,
    "gang": 2,
    "dong": 2,
    "qing": 1
   },
   {
    "label": "走平坦的，慢些不妨",
    "shan": 0,
    "gang": -2,
    "dong": -2,
    "qing": -1
   },
   {
    "label": "抬头望望天，再作打算",
    "shan": 1,
    "gang": -1,
    "dong": -1,
    "qing": -2
   },
   {
    "label": "怂恿旁人先去探崖路",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_21",
  "text": "破境正到紧要处，心魔化作你最敬重的人，立在面前叹息着劝你停下。你抬起头来，怎么办？",
  "options": [
   {
    "label": "拔剑便斩，不讲情面",
    "shan": 0,
    "gang": 2,
    "dong": 2,
    "qing": -1
   },
   {
    "label": "坐下与它对谈，谈到它散",
    "shan": 2,
    "gang": -2,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "依它的话，退一步再来",
    "shan": -1,
    "gang": -1,
    "dong": -2,
    "qing": 1
   },
   {
    "label": "反手吞下它的力，硬冲",
    "shan": -2,
    "gang": 1,
    "dong": 1,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_22",
  "text": "山路上，一位老者拦下你，递来一粒丹，说服下能添十年功力，却不肯通报姓名。你吃不吃？",
  "options": [
   {
    "label": "谢过收下，回去再细看",
    "shan": 1,
    "gang": -1,
    "dong": -1,
    "qing": 1
   },
   {
    "label": "仰头吞服，赌这一回",
    "shan": -1,
    "gang": 2,
    "dong": 2,
    "qing": 2
   },
   {
    "label": "原样奉还，无功不受禄",
    "shan": 1,
    "gang": 2,
    "dong": -1,
    "qing": -1
   },
   {
    "label": "先问来历，顺势套他的底",
    "shan": -2,
    "gang": -2,
    "dong": 0,
    "qing": -1
   }
  ]
 },
 {
  "id": "wx_23",
  "text": "师弟被长老冤枉，正跪在刑堂受罚，能证他清白的东西此刻就揣在你袖中。堂上众人都望着你，怎么办？",
  "options": [
   {
    "label": "走上堂去，当众亮出证据",
    "shan": 2,
    "gang": 1,
    "dong": 1,
    "qing": -2
   },
   {
    "label": "一言不发，陪师弟同跪",
    "shan": 1,
    "gang": 2,
    "dong": -2,
    "qing": 2
   },
   {
    "label": "先忍下，回头搜证翻案",
    "shan": 1,
    "gang": -2,
    "dong": 2,
    "qing": -2
   },
   {
    "label": "劝师弟认下算了",
