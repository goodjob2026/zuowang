# 测试服部署配置：cp .env.test.example .env.test && chmod 600 .env.test 后填写（.env.test 不进 git、不进镜像）。
# scripts/deploy.sh test 读它生成服务器上的 .env；同名环境变量优先于本文件。<…> 没填就部署，脚本会拒绝。

MG_PF_CODE=zuowang
# 测试环境中台后台列出的会话公钥（和正式环境不是同一套），格式同 .env.prod.example
MG_PUBLIC_KEYS='{"<kid>":"-----BEGIN PUBLIC KEY-----\n<公钥内容>\n-----END PUBLIC KEY-----\n"}'
# 测试环境的游戏站点；测试服直连是 http，但 NODE_ENV=production 下这里只能写 https
CORS_ORIGIN=https://<测试游戏站点域名>
